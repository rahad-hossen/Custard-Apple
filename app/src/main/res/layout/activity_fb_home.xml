<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:fillViewport="true"
    tools:context=".fb_home"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:layout_gravity="center"
            >

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/back_icon"
                android:layout_gravity="center"
                android:layout_marginRight="10dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fb Work"
                android:textColor="@color/card_green_dark"
                android:textSize="24sp"
                android:layout_gravity="center"
                android:textStyle="bold" />

        </LinearLayout>



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter credentials and view results"
            android:textColor="#666666"
            android:layout_marginBottom="25dp"
            android:textSize="14sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="15dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your UID"
                    android:textColor="@color/card_green_dark"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Enter UID"
                    android:paddingHorizontal="10dp"
                    android:layout_marginBottom="15dp"
                    android:background="@drawable/input_background" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textColor="@color/card_green_dark"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Enter password"
                    android:paddingHorizontal="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/input_background" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnViewCookies"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginBottom="15dp"
                    android:text="View Cookies"
                    android:textAllCaps="false"
                    android:textColor="@color/card_green_dark"
                    android:textStyle="bold"
                    android:background="@drawable/button_outline_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cookies"
                    android:textColor="@color/card_green_dark"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etCookies"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="Cookies will appear here..."
                    android:gravity="top|start"
                    android:padding="10dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/input_background" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:weightSum="2">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/SaveBtn"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="5dp"
                        android:text="Save"
                        android:textAllCaps="false"
                        android:textColor="@color/card_green_dark"
                        android:background="@drawable/button_outline_bg" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Web Preview (Login here)"
            android:textColor="@color/card_green_dark"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="800dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="30dp">

            <WebView
                android:id="@+id/myWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Developed by Rahad"
            android:layout_marginBottom="20dp"
            android:textColor="@color/text_dark" />

    </LinearLayout>
</ScrollView>