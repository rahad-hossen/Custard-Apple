<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Insta-cookies"
            android:textColor="@color/card_green_dark"
            android:textSize="24sp"
            android:layout_marginTop="20dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter credentials and view results"
            android:textColor="#666666"
            android:layout_marginBottom="25dp"
            android:textSize="14sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="15dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    android:textColor="@color/card_green_dark"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Enter username"
                    android:paddingHorizontal="10dp"
                    android:layout_marginBottom="15dp"
                    android:background="@drawable/input_background" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textColor="@color/card_green_dark"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Enter password"
                    android:paddingHorizontal="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/input_background" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnViewCookies"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginBottom="15dp"
                    android:text="View Cookies"
                    android:textAllCaps="false"
                    android:textColor="@color/card_green_dark"
                    android:textStyle="bold"
                    android:background="@drawable/button_outline_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cookies"
                    android:textColor="@color/card_green_dark"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etCookies"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="Cookies will appear here..."
                    android:gravity="top|start"
                    android:padding="10dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/input_background" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:weightSum="2">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnCopy"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:layout_marginRight="5dp"
                        android:text="Copy"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:background="@drawable/button_green_bg" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/SaveBtn"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="5dp"
                        android:text="Save"
                        android:textAllCaps="false"
                        android:textColor="@color/card_green_dark"
                        android:background="@drawable/button_outline_bg" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2FA CODE"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/card_green_dark"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/drop_down"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/drop_down"
                        android:layout_gravity="center"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="5dp"
                        />
                    <ImageView
                        android:id="@+id/drop_up"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/drop_up"
                        android:layout_gravity="center"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="5dp"
                        android:visibility="gone"
                        />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/parentVisible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    >
                    <EditText
                        android:id="@+id/TwoFA"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Enter your two FA"
                        android:paddingHorizontal="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/input_background" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/getCode"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginBottom="15dp"
                        android:text="Get code"
                        android:textAllCaps="false"
                        android:textColor="@color/card_green_dark"
                        android:textStyle="bold"
                        android:background="@drawable/button_outline_bg" />


                </LinearLayout>


            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Web Preview (Login here)"
            android:textColor="@color/card_green_dark"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="800dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="30dp">


            <WebView
                android:id="@+id/myWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <WebView
                android:id="@+id/myWebView2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Developed by Rahad"
            android:layout_marginBottom="20dp"
            android:textColor="@color/text_dark" />

    </LinearLayout>
</ScrollView>